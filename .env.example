# 복사해서 .env.local 로 저장한 뒤 값을 채우세요. (배포 시에는 호스팅 서비스의 환경변수 설정에 같은 이름으로 입력)

# 로그인 비밀번호 (필수 — 운영 환경에서 비어 있으면 아무도 들어갈 수 없습니다)
AUTH_PASSWORD=
# 세션 쿠키 서명용 임의 문자열 (32자 이상 권장: openssl rand -hex 32)
AUTH_SECRET=

# 구글 시트 연결 (셋 다 비어 있으면 미리보기용 가짜 데이터로 동작)
# 시트 주소 https://docs.google.com/spreadsheets/d/<여기>/edit 의 <여기> 부분
GOOGLE_SHEET_ID=
# 서비스 계정 이메일 (예: rent-app@my-project.iam.gserviceaccount.com) — 시트를 이 주소와 '편집자'로 공유
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 서비스 계정 JSON 키의 private_key 값 (줄바꿈은 \n 그대로 두고 큰따옴표로 감싸기)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
